{
  "schemaVersion": "1.0",
  "id": "in-place-reload",
  "title": "Components compiled at launch, reloaded in place or re-created, keeping what the user typed",
  "description": [
    "Covers what the Todo journey doesn't. A UserControl compiled at launch is re-initialized in place: its root-scope",
    "x:Bind must be re-evaluated and its root event (SizeChanged) must stay subscribed exactly once. A Frame-hosted page",
    "is re-created by markup and by C# edits. Text the user typed and boxes they checked survive both, while a starting",
    "value the markup itself changes still wins."
  ],
  "app": { "template": "app-template", "assetsFrom": "samples/winui-app/Assets", "projectFile": "TodoBench.csproj", "rootNamespace": "TodoBench" },
  "dimensions": [],
  "variants": [ { "id": "default", "primary": true, "summary": "The only ordering.", "choices": {} } ],
  "setup": [
    {
      "id": "setup-titlecard-xaml",
      "file": "TitleCard.xaml",
      "edit": {
        "op": "create-file",
        "text": [
          "<?xml version=\"1.0\" encoding=\"utf-8\" ?>",
          "<UserControl",
          "    x:Class=\"TodoBench.TitleCard\"",
          "    xmlns=\"http://schemas.microsoft.com/winfx/2006/xaml/presentation\"",
          "    xmlns:x=\"http://schemas.microsoft.com/winfx/2006/xaml\"",
          "    Width=\"300\"",
          "    SizeChanged=\"OnSizeChanged\">",
          "    <StackPanel>",
          "        <TextBlock x:Name=\"TitleText\" Text=\"{x:Bind Title}\" />",
          "        <TextBlock x:Name=\"CountText\" />",
          "        <TextBox x:Name=\"NoteBox\" />",
          "        <TextBox x:Name=\"DraftBox\" Text=\"draft\" />",
          "        <CheckBox x:Name=\"DoneBox\" Content=\"Done\" />",
          "    </StackPanel>",
          "</UserControl>"
        ]
      }
    },
    {
      "id": "setup-titlecard-cs",
      "file": "TitleCard.xaml.cs",
      "edit": {
        "op": "create-file",
        "text": [
          "using Microsoft.UI.Xaml;",
          "using Microsoft.UI.Xaml.Controls;",
          "",
          "namespace TodoBench;",
          "",
          "public sealed partial class TitleCard : UserControl",
          "{",
          "    private int _sizeChanges;",
          "",
          "    public TitleCard()",
          "    {",
          "        InitializeComponent();",
          "    }",
          "",
          "    public string Title => \"Hello\";",
          "",
          "    private void OnSizeChanged(object sender, SizeChangedEventArgs e)",
          "    {",
          "        _sizeChanges++;",
          "        CountText.Text = $\"size changes: {_sizeChanges}\";",
          "    }",
          "}"
        ]
      }
    },
    {
      "id": "setup-notespage-xaml",
      "file": "NotesPage.xaml",
      "edit": {
        "op": "create-file",
        "text": [
          "<?xml version=\"1.0\" encoding=\"utf-8\" ?>",
          "<Page",
          "    x:Class=\"TodoBench.NotesPage\"",
          "    xmlns=\"http://schemas.microsoft.com/winfx/2006/xaml/presentation\"",
          "    xmlns:x=\"http://schemas.microsoft.com/winfx/2006/xaml\">",
          "    <StackPanel>",
          "        <TextBlock Text=\"Notes\" />",
          "        <TextBox x:Name=\"PageNote\" />",
          "    </StackPanel>",
          "</Page>"
        ]
      }
    },
    {
      "id": "setup-notespage-cs",
      "file": "NotesPage.xaml.cs",
      "edit": {
        "op": "create-file",
        "text": [
          "using Microsoft.UI.Xaml.Controls;",
          "",
          "namespace TodoBench;",
          "",
          "public sealed partial class NotesPage : Page",
          "{",
          "    public NotesPage()",
          "    {",
          "        InitializeComponent();",
          "    }",
          "}"
        ]
      }
    },
    {
      "id": "setup-host-both",
      "file": "MainWindow.xaml",
      "edit": {
        "op": "replace",
        "find": [
          "        <TextBlock",
          "            x:Name=\"StartHere\"",
          "            Margin=\"24\"",
          "            Text=\"Nothing here yet.\" />"
        ],
        "text": [
          "        <StackPanel>",
          "            <local:TitleCard />",
          "            <Frame x:Name=\"NotesFrame\" />",
          "        </StackPanel>"
        ]
      }
    },
    {
      "id": "setup-navigate-notes",
      "file": "MainWindow.xaml.cs",
      "edit": {
        "op": "insert-after",
        "anchor": ["        InitializeComponent();"],
        "text": ["        NotesFrame.Navigate(typeof(NotesPage));"]
      }
    }
  ],
  "segments": [
    {
      "kind": "common",
      "phase": "reload-in-place",
      "title": "Reload the card and the page while the user has typed into them",
      "actions": [
        {
          "id": "r1-widen-card",
          "title": "Widen the card",
          "file": "TitleCard.xaml",
          "edit": { "op": "replace", "find": ["    Width=\"300\""], "text": ["    Width=\"320\""] },
          "checkpoint": {
            "id": "k1-bound-and-wired-once",
            "kind": "launch",
            "runtimeState": "The x:Bind title is still shown, and the one resize ran the handler exactly once (the compiled subscription was replaced, not doubled). Then the user types and checks things.",
            "uiChecks": [
              { "target": "TitleText", "assert": "text-equals", "value": "Hello" },
              { "target": "CountText", "assert": "number-increased" },
              { "target": "NoteBox", "assert": "set-value", "value": "typed in card" },
              { "target": "DraftBox", "assert": "set-value", "value": "mine" },
              { "target": "DoneBox", "assert": "toggle-on" },
              { "target": "PageNote", "assert": "set-value", "value": "typed in page" }
            ]
          }
        },
        {
          "id": "r2-widen-again",
          "title": "Widen the card again",
          "file": "TitleCard.xaml",
          "edit": { "op": "replace", "find": ["    Width=\"320\""], "text": ["    Width=\"340\""] },
          "checkpoint": {
            "id": "k2-card-state-kept",
            "kind": "launch",
            "runtimeState": "No handler piles up, and what the user typed and checked in the card survives its re-initialization.",
            "uiChecks": [
              { "target": "TitleText", "assert": "text-equals", "value": "Hello" },
              { "target": "CountText", "assert": "number-increased" },
              { "target": "NoteBox", "assert": "text-equals", "value": "typed in card" },
              { "target": "DraftBox", "assert": "text-equals", "value": "mine" },
              { "target": "DoneBox", "assert": "toggle-state-equals", "value": "On" }
            ]
          }
        },
        {
          "id": "r3-page-markup",
          "title": "Retitle the page in markup",
          "file": "NotesPage.xaml",
          "edit": { "op": "replace", "find": ["        <TextBlock Text=\"Notes\" />"], "text": ["        <TextBlock Text=\"My notes\" />"] },
          "checkpoint": {
            "id": "k3-page-state-kept",
            "kind": "launch",
            "runtimeState": "The page is re-created through its Frame and the note the user typed is still there.",
            "uiChecks": [
              { "target": "My notes", "assert": "exists" },
              { "target": "PageNote", "assert": "text-equals", "value": "typed in page" }
            ]
          }
        },
        {
          "id": "r4-page-code",
          "title": "Give the page a field in C#",
          "file": "NotesPage.xaml.cs",
          "edit": { "op": "insert-before", "anchor": ["    public NotesPage()"], "text": ["    private readonly int _created = System.Environment.TickCount;", ""] },
          "checkpoint": {
            "id": "k4-page-state-kept-after-code",
            "kind": "launch",
            "runtimeState": "A C# edit that re-creates the page keeps the note too.",
            "uiChecks": [
              { "target": "PageNote", "assert": "text-equals", "value": "typed in page" }
            ]
          }
        },
        {
          "id": "r5-markup-default-wins",
          "title": "Change the draft box's starting text in markup",
          "file": "TitleCard.xaml",
          "edit": { "op": "replace", "find": ["        <TextBox x:Name=\"DraftBox\" Text=\"draft\" />"], "text": ["        <TextBox x:Name=\"DraftBox\" Text=\"final\" />"] },
          "checkpoint": {
            "id": "k5-markup-wins",
            "kind": "launch",
            "runtimeState": "The author changed the value in markup, so the markup wins over the typed value; the other typed values stay.",
            "uiChecks": [
              { "target": "DraftBox", "assert": "text-equals", "value": "final" },
              { "target": "NoteBox", "assert": "text-equals", "value": "typed in card" }
            ]
          }
        }
      ]
    }
  ]
}
