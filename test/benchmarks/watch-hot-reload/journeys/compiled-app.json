          "<?xml version=\"1.0\" encoding=\"utf-8\" ?>",
          "<UserControl",
          "    x:Class=\"SideKit.Badge\"",
          "    xmlns=\"http://schemas.microsoft.com/winfx/2006/xaml/presentation\"",
          "    xmlns:x=\"http://schemas.microsoft.com/winfx/2006/xaml\">",
          "    <Button AutomationProperties.AutomationId=\"BadgeBtn\" Content=\"badge v1\" />",
          "</UserControl>"
        ]
      }
    },
    {
      "id": "setup-lib-badge-code",
      "title": "Its code",
      "file": "..\\SideKit\\Badge.xaml.cs",
      "edit": {
        "op": "create-file",
        "text": [
          "using Microsoft.UI.Xaml.Controls;",
          "",
          "namespace SideKit;",
          "",
          "public sealed partial class Badge : UserControl",
          "{",
          "    public Badge()",
          "    {",
          "        InitializeComponent();",
          "    }",
          "}"
        ]
      }
    },
    {
      "id": "setup-references",
      "title": "The MVVM Toolkit and the library",
      "file": "TodoBench.csproj",
      "edit": {
        "op": "replace",
        "find": [
          "<PackageReference Include=\"Microsoft.Windows.SDK.BuildTools\""
        ],
        "text": [
          "<PackageReference Include=\"CommunityToolkit.Mvvm\" Version=\"8.4.2\" />",
          "    <ProjectReference Include=\"..\\SideKit\\SideKit.csproj\" />",
          "    <PackageReference Include=\"Microsoft.Windows.SDK.BuildTools\""
        ]
      }
    },
    {
      "id": "setup-fmt",
      "title": "An x:Bind function",
      "file": "Fmt.cs",
      "edit": {
        "op": "create-file",
        "text": [
          "namespace TodoBench;",
          "",
          "public static class Fmt",
          "{",
          "    public static string Shout(string s) => \"^\" + s;",
          "}"
        ]
      }
    },
    {
      "id": "setup-converter",
      "title": "A value converter",
      "file": "StarsConverter.cs",
      "edit": {
        "op": "create-file",
        "text": [
          "using Microsoft.UI.Xaml.Data;",
          "",
          "namespace TodoBench;",
          "",
          "public sealed partial class StarsConverter : IValueConverter",
          "{",
          "    public object Convert(object value, Type targetType, object parameter, string language) => $\"+{value}+\";",
          "",
          "    public object ConvertBack(object value, Type targetType, object parameter, string language) => throw new NotImplementedException();",
          "}"
        ]
      }
    },
    {
      "id": "setup-item",
      "title": "A record shown in a DataTemplate",
      "file": "Item.cs",
      "edit": {
        "op": "create-file",
        "text": [
          "namespace TodoBench;",
          "",
          "public sealed record Item(int Id, string Name)",
          "{",
          "    public string Display => $\"M{Id}:{Name}\";",
          "}"
        ]
      }
    },
    {
      "id": "setup-vm",
      "title": "An MVVM Toolkit view model",
      "file": "MainViewModel.cs",
      "edit": {
        "op": "create-file",
        "text": [
          "using CommunityToolkit.Mvvm.ComponentModel;",
          "using CommunityToolkit.Mvvm.Input;",
          "",
          "namespace TodoBench;",
          "",
          "public partial class MainViewModel : ObservableObject",
          "{",
          "    [ObservableProperty]",
          "    public partial string Status { get; set; } = \"Ready\";",
          "",
          "    [ObservableProperty]",
          "    public partial int Counter { get; set; }",
          "",
          "    [ObservableProperty]",
          "    public partial string Draft { get; set; } = \"draft\";",
          "",
          "    [ObservableProperty]",
          "    public partial string Mood { get; set; } = \"calm\";",
          "",
          "    public List<Item> Items { get; } = [new(1, \"Item 1\"), new(2, \"Item 2\")];",
          "",
          "    [RelayCommand]",
          "    private void Increment() => Counter++;",
          "}"
        ]
      }
    },
    {
      "id": "setup-page",
      "title": "A compiled page",
      "file": "MainPage.xaml",
      "edit": {
        "op": "create-file",
        "text": [
          "<?xml version=\"1.0\" encoding=\"utf-8\" ?>",
          "<Page",
          "    x:Class=\"TodoBench.MainPage\"",
          "    xmlns=\"http://schemas.microsoft.com/winfx/2006/xaml/presentation\"",
          "    xmlns:x=\"http://schemas.microsoft.com/winfx/2006/xaml\"",
          "    xmlns:local=\"using:TodoBench\"",
          "    xmlns:side=\"using:SideKit\">",
          "    <Page.Resources>",
          "        <local:StarsConverter x:Key=\"Stars\" />",
          "    </Page.Resources>",
          "    <StackPanel Spacing=\"8\" Margin=\"16\">",
          "        <TextBlock AutomationProperties.AutomationId=\"PageLabel\" Text=\"page v1\" />",
          "        <TextBlock AutomationProperties.AutomationId=\"Fn\" Text=\"{x:Bind local:Fmt.Shout(ViewModel.Status), Mode=OneWay}\" />",
          "        <TextBlock AutomationProperties.AutomationId=\"Conv\" Text=\"{x:Bind ViewModel.Counter, Converter={StaticResource Stars}, Mode=OneWay}\" />",
          "        <Button AutomationProperties.AutomationId=\"Inc\" Content=\"Add\" Command=\"{x:Bind ViewModel.IncrementCommand}\" />",
          "        <TextBlock AutomationProperties.AutomationId=\"Weather\" Text=\"{x:Bind ViewModel.Status, Mode=OneWay}\" />",
          "        <ItemsRepeater ItemsSource=\"{x:Bind ViewModel.Items}\">",
          "            <ItemsRepeater.ItemTemplate>",
          "                <DataTemplate x:DataType=\"local:Item\">",
          "                    <TextBlock x:Phase=\"1\" AutomationProperties.AutomationId=\"Disp\" Text=\"{x:Bind Display}\" />",
          "                </DataTemplate>",
          "            </ItemsRepeater.ItemTemplate>",
          "        </ItemsRepeater>",
          "        <side:Badge />",
          "        <local:CardView />",
          "        <TextBlock x:Name=\"Flags\" AutomationProperties.AutomationId=\"Flags\" Text=\"none\" />",
          "        <TextBlock AutomationProperties.AutomationId=\"Mood\" Text=\"{x:Bind ViewModel.Mood, Mode=OneWay}\" />",
          "    </StackPanel>",
          "</Page>"
        ]
      }
    },
    {
      "id": "setup-page-code",
