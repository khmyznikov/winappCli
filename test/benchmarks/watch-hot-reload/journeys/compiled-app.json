                "value": "page v2"
              },
              {
                "target": "Fn",
                "assert": "text-equals",
                "value": "$Ready"
              },
              {
                "target": "Conv",
                "assert": "text-equals",
                "value": "STARS[0]"
              },
              {
                "target": "Disp",
                "assert": "text-equals",
                "value": "no.1 Item 1"
              }
            ]
          }
        },
        {
          "id": "b05-function-body-again",
          "title": "N5: and the same edits show on the reloaded page",
