  "segments": [
    {
      "kind": "common",
      "phase": "compiled",
      "title": "compiled",
      "actions": [
        {
          "id": "b01-function-body",
          "title": "N5: an x:Bind function body edit shows on the page as built",
          "file": "Fmt.cs",
          "edit": {
            "op": "replace",
            "find": [
              "\"^\" + s"
            ],
            "text": [
              "\"$\" + s"
            ]
          },
          "checkpoint": {
            "id": "c-b01-function-body",
            "kind": "live",
            "uiChecks": [
              {
                "target": "Fn",
                "assert": "text-equals",
                "value": "$Ready"
              }
            ]
          },
          "expect": {
            "outcome": "applied"
          }
        },
        {
          "id": "b02-converter-body",
          "title": "N11: a converter body edit shows",
          "file": "StarsConverter.cs",
          "edit": {
            "op": "replace",
            "find": [
              "$\"+{value}+\""
            ],
            "text": [
              "$\"STARS[{value}]\""
            ]
          },
          "checkpoint": {
            "id": "c-b02-converter-body",
            "kind": "live",
            "uiChecks": [
              {
                "target": "Conv",
                "assert": "text-equals",
                "value": "STARS[0]"
              }
            ]
          },
          "expect": {
            "outcome": "applied"
          }
        },
        {
          "id": "b03-record-getter",
          "title": "N11: a computed property of an object without change notification, in a phased DataTemplate",
          "file": "Item.cs",
          "edit": {
            "op": "replace",
            "find": [
              "$\"M{Id}:{Name}\""
            ],
            "text": [
              "$\"no.{Id} {Name}\""
            ]
          },
          "checkpoint": {
            "id": "c-b03-record-getter",
            "kind": "live",
            "uiChecks": [
              {
                "target": "Disp",
                "assert": "text-equals",
                "value": "no.1 Item 1"
              }
            ]
          },
          "expect": {
            "outcome": "applied"
          }
        },
        {
          "id": "b04-page-markup",
          "title": "The page reloads from markup",
          "file": "MainPage.xaml",
          "edit": {
            "op": "replace",
            "find": [
              "Text=\"page v1\""
            ],
