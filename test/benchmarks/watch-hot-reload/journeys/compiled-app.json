{
  "schemaVersion": "1.0",
  "id": "compiled-app",
  "title": "Edits to an app as it was built: compiled x:Bind, an MVVM Toolkit view model, a page the code uses, and a library next to the app",
  "description": [
    "Starts from code the XAML compiler built: an x:Bind function, a converter and a record's computed property in a phased DataTemplate are edited before and after the page reloads from markup. [ObservableProperty] partial properties are added, deleted and renamed. A compiled page that code still refers to is deleted. A bound property is renamed code-first, and session-added properties are renamed again. A page's markup is deleted while its code remains. A folder of pages is renamed. A class library in a sibling folder (a solution layout) is edited: markup live, C# with a restart. A Directory.Build.props edit rebuilds. The restarts at b17 and b19 are expected."
  ],
  "app": {
    "template": "app-template",
    "assetsFrom": "samples/winui-app/Assets",
    "projectFile": "TodoBench.csproj",
    "rootNamespace": "TodoBench"
  },
  "setup": [
    {
      "id": "setup-lib-project",
      "title": "A class library next to the app",
      "file": "..\\SideKit\\SideKit.csproj",
      "edit": {
        "op": "create-file",
        "text": [
          "<Project Sdk=\"Microsoft.NET.Sdk\">",
          "  <PropertyGroup>",
          "    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>",
          "    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>",
          "    <Platforms>x86;x64;ARM64</Platforms>",
          "    <RuntimeIdentifier Condition=\"'$(RuntimeIdentifier)' == ''\">win-$([System.Runtime.InteropServices.RuntimeInformation]::ProcessArchitecture.ToString().ToLowerInvariant())</RuntimeIdentifier>",
          "    <UseWinUI>true</UseWinUI>",
          "    <WinUISDKReferences>false</WinUISDKReferences>",
          "    <EnableMsixTooling>true</EnableMsixTooling>",
          "    <ImplicitUsings>enable</ImplicitUsings>",
          "    <Nullable>enable</Nullable>",
          "  </PropertyGroup>",
          "  <ItemGroup>",
          "    <PackageReference Include=\"Microsoft.Windows.SDK.BuildTools\" Version=\"10.0.28000.2526\" />",
          "    <PackageReference Include=\"Microsoft.WindowsAppSDK\" Version=\"2.3.1\" />",
          "  </ItemGroup>",
          "</Project>"
        ]
      }
    },
    {
      "id": "setup-lib-badge",
      "title": "Its control",
      "file": "..\\SideKit\\Badge.xaml",
      "edit": {
        "op": "create-file",
