          "title": "A new UserControl: its code",
          "file": "Badge.xaml.cs",
          "edit": {
            "op": "create-file",
            "text": [
              "using Microsoft.UI.Xaml;",
              "using Microsoft.UI.Xaml.Controls;",
              "",
              "namespace TodoBench;",
