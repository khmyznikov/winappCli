{
  "schemaVersion": "1.0",
  "id": "todo-app",
  "title": "Authored-edit Todo app (local, build-only, no hot reload)",
  "description": [
    "One person building a Todo app in WinUI 3 the way people actually build one: a page, some",
    "navigation, a grid, a handler, a view model, a bound list, then some restructuring.",
    "Every action is exactly ONE authored edit followed by ONE save. Nothing here uses hot reload;",
    "the baseline being measured is the plain edit -> save -> build loop.",
    "Some saves are deliberately invalid, because that is what half-finished authoring looks like."
  ],
  "app": {
    "template": "app-template",
    "assetsFrom": "samples/winui-app/Assets",
    "projectFile": "TodoBench.csproj",
    "rootNamespace": "TodoBench"
  },
  "dimensions": [
    {
      "id": "handler-wiring",
      "title": "Wiring a Click handler",
      "options": ["handler-first", "xaml-first"],
      "description": [
        "handler-first: write the C# method, then point the XAML at it. Every save stays buildable.",
        "xaml-first: type Click=\"AddButton_Click\" first, then go write the method. The first save",
        "does not build, because the generated connector calls a method that does not exist yet."
      ]
    },
    {
      "id": "binding-wiring",
      "title": "Wiring an x:Bind to a view-model property",
      "options": ["vm-property-first", "binding-first"],
      "description": [
        "vm-property-first: add the property to the view model, then bind to it. Every save builds.",
        "binding-first: write the x:Bind first, then add the property. The first save fails in the",
        "XAML compiler, because the binding path cannot be resolved on the source type."
      ]
    }
  ],
  "variants": [
    {
      "id": "code-first",
      "primary": true,
      "summary": "Handler before XAML, view-model property before binding. Never saves a broken wiring.",
      "choices": { "handler-wiring": "handler-first", "binding-wiring": "vm-property-first" }
    },
    {
      "id": "markup-first",
      "primary": true,
      "summary": "XAML before handler, binding before property. Passes through an invalid save each time.",
      "choices": { "handler-wiring": "xaml-first", "binding-wiring": "binding-first" }
    },
    {
      "id": "mixed-handler-first",
      "primary": false,
      "summary": "Handler before XAML, but binding before property.",
      "choices": { "handler-wiring": "handler-first", "binding-wiring": "binding-first" }
    },
    {
      "id": "mixed-markup-first",
      "primary": false,
      "summary": "XAML before handler, but view-model property before binding.",
      "choices": { "handler-wiring": "xaml-first", "binding-wiring": "vm-property-first" }
    }
  ],
  "segments": [
    {
      "kind": "common",
      "phase": "page-and-navigation",
      "title": "Give the app a page and navigate to it",
      "actions": [
        {
          "id": "a01-create-mainpage-xaml",
          "title": "Create MainPage.xaml",
          "intent": "Real UI should not live in the Window; start a Page.",
          "covers": ["page-creation"],
          "file": "MainPage.xaml",
          "edit": {
            "op": "create-file",
            "text": [
              "<?xml version=\"1.0\" encoding=\"utf-8\" ?>",
              "<Page",
              "    x:Class=\"TodoBench.MainPage\"",
              "    xmlns=\"http://schemas.microsoft.com/winfx/2006/xaml/presentation\"",
              "    xmlns:x=\"http://schemas.microsoft.com/winfx/2006/xaml\"",
              "    xmlns:d=\"http://schemas.microsoft.com/expression/blend/2008\"",
              "    xmlns:local=\"using:TodoBench\"",
              "    xmlns:mc=\"http://schemas.openxmlformats.org/markup-compatibility/2006\"",
              "    mc:Ignorable=\"d\">",
              "",
              "    <Grid x:Name=\"RootGrid\" Margin=\"24\">",
              "    </Grid>",
              "</Page>"
            ]
          }
        },
        {
          "id": "a02-create-mainpage-cs",
          "title": "Create MainPage.xaml.cs",
          "intent": "The Page needs its partial class before the XAML compiler will accept it.",
          "covers": ["page-creation"],
          "file": "MainPage.xaml.cs",
          "edit": {
            "op": "create-file",
            "text": [
              "using Microsoft.UI.Xaml;",
              "using Microsoft.UI.Xaml.Controls;",
              "",
              "namespace TodoBench;",
              "",
              "public sealed partial class MainPage : Page",
              "{",
              "    public MainPage()",
              "    {",
              "        InitializeComponent();",
              "    }",
              "}"
            ]
          }
        },
        {
          "id": "a03-window-hosts-frame",
          "title": "Replace the placeholder text with a Frame",
          "intent": "The Window becomes a shell that hosts pages.",
          "covers": ["navigation", "x-name"],
          "file": "MainWindow.xaml",
          "edit": {
            "op": "replace",
            "find": [
              "        <TextBlock",
              "            x:Name=\"StartHere\"",
              "            Margin=\"24\"",
              "            Text=\"Nothing here yet.\" />"
            ],
            "text": ["        <Frame x:Name=\"RootFrame\" />"]
          }
        },
        {
          "id": "a04-navigate-to-mainpage",
          "title": "Navigate the frame to MainPage on startup",
          "intent": "Without this the shell renders an empty frame.",
          "covers": ["navigation"],
          "file": "MainWindow.xaml.cs",
          "edit": {
            "op": "insert-after",
            "anchor": ["        InitializeComponent();"],
            "text": ["", "        RootFrame.Navigate(typeof(MainPage));"]
          },
          "checkpoint": {
            "id": "c1-empty-page-hosted",
            "kind": "launch",
            "runtimeState": "Window titled TodoBench opens and is completely empty: the frame is hosting a page that has nothing in it. Nothing is interactive yet.",
            "uiChecks": [
              { "target": "RootFrame", "assert": "exists" }
            ]
          }
        }
      ]
    },
    {
      "kind": "common",
      "phase": "layout",
      "title": "Lay the page out in a Grid",
      "actions": [
        {
          "id": "a05-add-row-definitions",
          "title": "Add three row definitions to the page grid",
          "intent": "Header row, input row, list row.",
          "covers": ["grid-rows"],
          "file": "MainPage.xaml",
          "edit": {
            "op": "insert-after",
            "anchor": ["    <Grid x:Name=\"RootGrid\" Margin=\"24\">"],
            "text": [
              "        <Grid.RowDefinitions>",
              "            <RowDefinition Height=\"Auto\" />",
              "            <RowDefinition Height=\"Auto\" />",
              "            <RowDefinition Height=\"*\" />",
              "        </Grid.RowDefinitions>"
            ]
          }
        },
        {
          "id": "a06-add-header-textblock",
          "title": "Add the header TextBlock in row 0",
          "intent": "A named element the code-behind can talk to.",
          "covers": ["grid-rows", "x-name"],
          "file": "MainPage.xaml",
          "edit": {
            "op": "insert-after",
            "anchor": ["        </Grid.RowDefinitions>"],
            "text": [
              "",
              "        <TextBlock",
              "            x:Name=\"HeaderText\"",
              "            Grid.Row=\"0\"",
              "            Style=\"{StaticResource TitleTextBlockStyle}\" />"
            ]
          }
        },
        {
          "id": "a07-add-input-row",
          "title": "Add the input row (TextBox + Add button) in row 1",
          "intent": "Somewhere to type a todo.",
          "covers": ["grid-rows", "x-name"],
          "file": "MainPage.xaml",
          "edit": {
            "op": "insert-after",
            "anchor": [
              "        <TextBlock",
              "            x:Name=\"HeaderText\"",
              "            Grid.Row=\"0\"",
              "            Style=\"{StaticResource TitleTextBlockStyle}\" />"
            ],
            "text": [
              "",
              "        <StackPanel",
              "            x:Name=\"InputRow\"",
              "            Grid.Row=\"1\"",
              "            Margin=\"0,12,0,12\"",
              "            Orientation=\"Horizontal\"",
              "            Spacing=\"8\">",
              "            <TextBox",
              "                x:Name=\"NewTodoBox\"",
              "                Width=\"260\"",
              "                PlaceholderText=\"What needs doing?\" />",
              "            <Button x:Name=\"AddButton\" Content=\"Add\" />",
              "        </StackPanel>"
            ]
          }
        },
        {
          "id": "a08-add-listview",
          "title": "Add the (still empty) ListView in row 2",
          "intent": "Where todos will land.",
          "covers": ["grid-rows", "x-name", "listview"],
          "file": "MainPage.xaml",
          "edit": {
            "op": "insert-after",
            "anchor": ["        </StackPanel>"],
            "text": ["", "        <ListView x:Name=\"TodoList\" Grid.Row=\"2\" />"]
          }
        },
        {
          "id": "a09-set-header-text-from-code",
          "title": "Set the header text from code-behind",
          "intent": "First code-behind reference to a named element.",
          "covers": ["x-name"],
          "file": "MainPage.xaml.cs",
          "edit": {
            "op": "insert-after",
            "anchor": ["        InitializeComponent();"],
            "text": ["", "        HeaderText.Text = \"Todos\";"]
          },
          "checkpoint": {
            "id": "c2-static-layout",
            "kind": "build",
            "runtimeState": "The page shows a Todos header, a text box with an Add button beside it, and an empty list filling the rest. Clicking Add does nothing yet."
          }
        }
      ]
    },
    {
      "kind": "swap",
      "phase": "handler-wiring",
      "dimension": "handler-wiring",
      "title": "Wire the Add button to a Click handler",
      "convergence": {
        "id": "cv1-handler-wired",
        "description": "Both orderings end with the same MainPage.xaml and MainPage.xaml.cs. Only the intermediate save differs: xaml-first has to pass through a build that cannot resolve the handler."
      },
      "orders": {
        "handler-first": ["s1-handler-method", "s1-xaml-click"],
        "xaml-first": ["s1-xaml-click", "s1-handler-method"]
      },
      "actions": [
        {
          "id": "s1-handler-method",
          "title": "Write the AddButton_Click method",
          "intent": "The behaviour behind the button.",
          "covers": ["handlers"],
          "file": "MainPage.xaml.cs",
          "edit": {
            "op": "insert-after",
            "anchor": [
              "    public MainPage()",
              "    {",
              "        InitializeComponent();",
              "",
              "        HeaderText.Text = \"Todos\";",
              "    }"
            ],
            "text": [
              "",
              "    private void AddButton_Click(object sender, RoutedEventArgs e)",
              "    {",
              "        var title = NewTodoBox.Text;",
              "        if (string.IsNullOrWhiteSpace(title))",
              "        {",
              "            return;",
              "        }",
              "",
              "        TodoList.Items.Add(title);",
              "    }"
            ]
          },
          "expectWhenFirst": "build-succeeds",
          "expectWhenSecond": "build-succeeds"
        },
        {
          "id": "s1-xaml-click",
          "title": "Point the button's Click at AddButton_Click",
          "intent": "The markup half of the wiring.",
          "covers": ["handlers"],
          "file": "MainPage.xaml",
          "edit": {
            "op": "replace",
            "find": ["            <Button x:Name=\"AddButton\" Content=\"Add\" />"],
            "text": ["            <Button x:Name=\"AddButton\" Click=\"AddButton_Click\" Content=\"Add\" />"]
          },
          "expectWhenFirst": "build-fails",
          "expectWhenSecond": "build-succeeds",
          "expectedDiagnosticsWhenFirst": ["CS1061"],
          "note": "When this lands first the generated connector calls a method that is not written yet."
        }
      ],
      "checkpoint": {
        "id": "c3-add-button-live",
        "kind": "launch",
        "runtimeState": "Typing \"Write the spec\" in the box and clicking Add appends one row reading \"Write the spec\" to the list. Clicking Add with an empty box does nothing.",
        "uiChecks": [
          { "target": "NewTodoBox", "assert": "set-value", "value": "Write the spec" },
          { "target": "AddButton", "assert": "invoke" },
          { "target": "TodoList", "assert": "child-count-equals", "value": "1" }
        ]
      }
    },
    {
      "kind": "common",
      "phase": "rename",
      "title": "Rename the header element (deliberately invalid intermediate save)",
      "actions": [
        {
          "id": "a10-rename-xname-in-xaml",
          "title": "Rename x:Name HeaderText to PageHeader",
          "intent": "Half of a rename. This is the save a person makes before they switch files. It does not build, and that is the point.",
          "covers": ["x-name", "invalid-intermediate"],
          "file": "MainPage.xaml",
          "edit": {
            "op": "replace",
            "find": ["            x:Name=\"HeaderText\""],
            "text": ["            x:Name=\"PageHeader\""]
          },
          "expect": "build-fails",
          "expectedDiagnostics": ["CS0103"],
          "deliberatelyInvalid": true,
          "note": "The generated field is now PageHeader, so the code-behind line referring to HeaderText no longer resolves."
        },
        {
          "id": "a11-rename-xname-in-code",
          "title": "Finish the rename in code-behind",
          "intent": "The second half of the same edit, one save later.",
          "covers": ["x-name", "invalid-intermediate"],
          "file": "MainPage.xaml.cs",
          "edit": {
            "op": "replace",
            "find": ["        HeaderText.Text = \"Todos\";"],
            "text": ["        PageHeader.Text = \"Todos\";"]
          },
          "checkpoint": {
            "id": "c4-rename-repaired",
            "kind": "build",
            "runtimeState": "Identical to c2/c3 from the user's point of view. The rename is invisible at runtime, which is exactly why the broken intermediate is easy to ship."
          }
        }
      ]
    },
    {
      "kind": "common",
      "phase": "mvvm",
      "title": "Introduce a view model and bind the list to it",
      "actions": [
        {
          "id": "a12-add-mvvm-package",
          "title": "Add the CommunityToolkit.Mvvm package reference",
          "intent": "A project-file save, which forces a restore before the next build.",
          "covers": ["mvvm", "project-file"],
          "file": "TodoBench.csproj",
          "edit": {
            "op": "replace",
            "find": ["    <PackageReference Include=\"Microsoft.WindowsAppSDK\" Version=\"2.3.1\" />"],
            "text": [
              "    <PackageReference Include=\"Microsoft.WindowsAppSDK\" Version=\"2.3.1\" />",
              "    <PackageReference Include=\"CommunityToolkit.Mvvm\" Version=\"8.4.2\" />"
            ]
          }
        },
        {
          "id": "a13-create-todoitem-model",
          "title": "Create Models/TodoItem.cs",
          "intent": "An observable item so the list can react to per-item changes.",
          "covers": ["mvvm"],
          "file": "Models/TodoItem.cs",
          "edit": {
            "op": "create-file",
            "text": [
              "using CommunityToolkit.Mvvm.ComponentModel;",
              "",
              "namespace TodoBench.Models;",
              "",
              "public partial class TodoItem : ObservableObject",
              "{",
              "    [ObservableProperty]",
              "    public partial string Title { get; set; }",
              "",
              "    [ObservableProperty]",
              "    public partial bool IsDone { get; set; }",
              "",
              "    public TodoItem()",
              "    {",
              "        Title = string.Empty;",
              "    }",
              "}"
            ]
          }
        },
        {
          "id": "a14-create-seed-helper",
          "title": "Create ViewModels/TodoSeed.cs",
          "intent": "Seed data, deliberately in its own file so it can be deleted later.",
          "covers": ["mvvm"],
          "file": "ViewModels/TodoSeed.cs",
          "edit": {
            "op": "create-file",
            "text": [
              "using System.Collections.Generic;",
              "using TodoBench.Models;",
              "",
              "namespace TodoBench.ViewModels;",
              "",
              "internal static class TodoSeed",
              "{",
              "    public static IEnumerable<TodoItem> Create()",
              "    {",
              "        yield return new TodoItem { Title = \"Buy milk\" };",
              "        yield return new TodoItem { Title = \"Ship the benchmark\", IsDone = true };",
              "    }",
              "}"
            ]
          }
        },
        {
          "id": "a15-create-viewmodel",
          "title": "Create ViewModels/TodoListViewModel.cs",
          "intent": "The ObservableCollection the ListView will bind to.",
          "covers": ["mvvm", "observable-collection"],
          "file": "ViewModels/TodoListViewModel.cs",
          "edit": {
            "op": "create-file",
            "text": [
              "using System.Collections.ObjectModel;",
              "using CommunityToolkit.Mvvm.ComponentModel;",
              "using TodoBench.Models;",
              "",
              "namespace TodoBench.ViewModels;",
              "",
              "public partial class TodoListViewModel : ObservableObject",
              "{",
              "    public TodoListViewModel()",
              "    {",
              "        foreach (var item in TodoSeed.Create())",
              "        {",
              "            Items.Add(item);",
              "        }",
              "    }",
              "",
              "    public ObservableCollection<TodoItem> Items { get; } = new();",
              "",
              "    public void AddTodo(string title)",
              "    {",
              "        if (string.IsNullOrWhiteSpace(title))",
              "        {",
              "            return;",
              "        }",
              "",
              "        Items.Add(new TodoItem { Title = title.Trim() });",
              "    }",
              "}"
            ]
          }
        },
        {
          "id": "a16-add-viewmodels-using",
          "title": "Import the ViewModels namespace in MainPage.xaml.cs",
          "intent": "One save that on its own changes nothing observable.",
          "covers": ["mvvm"],
          "file": "MainPage.xaml.cs",
          "edit": {
            "op": "insert-after",
            "anchor": ["using Microsoft.UI.Xaml.Controls;"],
            "text": ["using TodoBench.ViewModels;"]
          }
        },
        {
          "id": "a17-expose-viewmodel-property",
          "title": "Expose a ViewModel property on the page",
          "intent": "x:Bind resolves against the page, so the view model has to be reachable from it.",
          "covers": ["mvvm", "x-bind"],
          "file": "MainPage.xaml.cs",
          "edit": {
            "op": "insert-before",
            "anchor": ["    public MainPage()"],
            "text": ["    public TodoListViewModel ViewModel { get; } = new();", ""]
          }
        },
        {
          "id": "a18-add-models-xmlns",
          "title": "Declare the models xmlns on the page",
          "intent": "Needed before a DataTemplate can name x:DataType.",
          "covers": ["x-bind"],
          "file": "MainPage.xaml",
          "edit": {
            "op": "replace",
            "find": ["    xmlns:local=\"using:TodoBench\""],
            "text": [
              "    xmlns:local=\"using:TodoBench\"",
              "    xmlns:models=\"using:TodoBench.Models\""
            ]
          }
        },
        {
          "id": "a19-bind-itemssource",
          "title": "Bind ListView.ItemsSource with x:Bind",
          "intent": "The list stops being hand-fed.",
          "covers": ["x-bind", "listview", "observable-collection"],
          "file": "MainPage.xaml",
          "edit": {
            "op": "replace",
            "find": ["        <ListView x:Name=\"TodoList\" Grid.Row=\"2\" />"],
            "text": [
              "        <ListView",
              "            x:Name=\"TodoList\"",
              "            Grid.Row=\"2\"",
              "            ItemsSource=\"{x:Bind ViewModel.Items, Mode=OneWay}\" />"
            ]
          }
        },
        {
          "id": "a20-add-item-template",
          "title": "Add a DataTemplate for TodoItem",
          "intent": "Without it the list renders type names.",
          "covers": ["listview", "data-template", "x-bind"],
          "file": "MainPage.xaml",
          "edit": {
            "op": "replace",
            "find": [
              "        <ListView",
              "            x:Name=\"TodoList\"",
              "            Grid.Row=\"2\"",
              "            ItemsSource=\"{x:Bind ViewModel.Items, Mode=OneWay}\" />"
            ],
            "text": [
              "        <ListView",
              "            x:Name=\"TodoList\"",
              "            Grid.Row=\"2\"",
              "            ItemsSource=\"{x:Bind ViewModel.Items, Mode=OneWay}\">",
              "            <ListView.ItemTemplate>",
              "                <DataTemplate x:DataType=\"models:TodoItem\">",
              "                    <TextBlock Text=\"{x:Bind Title}\" />",
              "                </DataTemplate>",
              "            </ListView.ItemTemplate>",
              "        </ListView>"
            ]
          }
        },
        {
          "id": "a21-handler-calls-viewmodel",
          "title": "Move the Add behaviour into the view model",
          "intent": "The handler stops mutating ListView.Items directly, which would now throw.",
          "covers": ["mvvm", "handlers"],
          "file": "MainPage.xaml.cs",
          "edit": {
            "op": "replace",
            "find": [
              "        var title = NewTodoBox.Text;",
              "        if (string.IsNullOrWhiteSpace(title))",
              "        {",
              "            return;",
              "        }",
              "",
              "        TodoList.Items.Add(title);"
            ],
            "text": ["        ViewModel.AddTodo(NewTodoBox.Text);"]
          },
          "checkpoint": {
            "id": "c5-bound-list",
            "kind": "launch",
            "runtimeState": "Two seeded rows render through the DataTemplate: \"Buy milk\" and \"Ship the benchmark\". Typing a third title and clicking Add appends it, because the ObservableCollection raises the change.",
            "uiChecks": [
              { "target": "TodoList", "assert": "child-count-equals", "value": "2" },
              { "target": "NewTodoBox", "assert": "set-value", "value": "Write the spec" },
              { "target": "AddButton", "assert": "invoke" },
              { "target": "TodoList", "assert": "child-count-equals", "value": "3" }
            ]
          }
        }
      ]
    },
    {
      "kind": "swap",
      "phase": "binding-wiring",
      "dimension": "binding-wiring",
      "title": "Add a summary line bound to the view model",
      "convergence": {
        "id": "cv2-summary-bound",
        "description": "Both orderings end with the same MainPage.xaml and TodoListViewModel.cs. binding-first pays for it with a XAML-compiler failure on the intermediate save."
      },
      "orders": {
        "vm-property-first": ["s2-viewmodel-summary", "s2-xaml-summary"],
        "binding-first": ["s2-xaml-summary", "s2-viewmodel-summary"]
      },
      "actions": [
        {
          "id": "s2-viewmodel-summary",
          "title": "Add a Summary property to the view model",
          "intent": "Computed from the collection.",
          "covers": ["mvvm"],
          "file": "ViewModels/TodoListViewModel.cs",
          "edit": {
            "op": "insert-after",
            "anchor": ["    public ObservableCollection<TodoItem> Items { get; } = new();"],
            "text": [
              "",
              "    public string Summary => $\"{Items.Count(item => item.IsDone)} of {Items.Count} done\";"
            ]
          },
          "expectWhenFirst": "build-succeeds",
          "expectWhenSecond": "build-succeeds"
        },
        {
          "id": "s2-xaml-summary",
          "title": "Add a summary TextBlock bound with x:Bind",
          "intent": "Wraps the header in a StackPanel so a second line fits in row 0.",
          "covers": ["x-bind", "grid-rows"],
          "file": "MainPage.xaml",
          "edit": {
            "op": "replace",
            "find": [
              "        <TextBlock",
              "            x:Name=\"PageHeader\"",
              "            Grid.Row=\"0\"",
              "            Style=\"{StaticResource TitleTextBlockStyle}\" />"
            ],
            "text": [
              "        <StackPanel Grid.Row=\"0\" Spacing=\"4\">",
              "            <TextBlock",
              "                x:Name=\"PageHeader\"",
              "                Style=\"{StaticResource TitleTextBlockStyle}\" />",
              "            <TextBlock",
              "                x:Name=\"SummaryText\"",
              "                Foreground=\"{ThemeResource TextFillColorSecondaryBrush}\"",
              "                Text=\"{x:Bind ViewModel.Summary, Mode=OneWay}\" />",
              "        </StackPanel>"
            ]
          },
          "expectWhenFirst": "build-fails",
          "expectWhenSecond": "build-succeeds",
          "expectedDiagnosticsWhenFirst": ["WMC1110", "WMC9999"],
          "note": "When this lands first the XAML compiler cannot resolve Summary on TodoListViewModel. On WindowsAppSDK 2.3.x the markup compiler often fails to load its own error-string resources and reports the unresolved binding path as WMC9999 'Xaml Internal Error' with no mention of Summary at all, so both codes are accepted."
        }
      ],
      "checkpoint": {
        "id": "c6-summary-visible",
        "kind": "build",
        "runtimeState": "A secondary line under the header reads \"1 of 2 done\". It does not update yet when a todo is checked, because nothing raises the change."
      }
    },
    {
      "kind": "common",
      "phase": "completion",
      "title": "Make todos completable",
      "actions": [
        {
          "id": "a22-checkbox-in-template",
          "title": "Put a two-way bound CheckBox in the item template",
          "intent": "Completion has to be editable from the row. The AutomationId is bound to Title so a UI harness can address an individual row's checkbox, which is the only way to prove the two-way write-back rather than assume it.",
          "covers": ["data-template", "x-bind", "listview"],
          "file": "MainPage.xaml",
          "edit": {
            "op": "replace",
            "find": ["                    <TextBlock Text=\"{x:Bind Title}\" />"],
            "text": [
              "                    <StackPanel Orientation=\"Horizontal\" Spacing=\"8\">",
              "                        <CheckBox",
              "                            AutomationProperties.AutomationId=\"{x:Bind Title}\"",
              "                            IsChecked=\"{x:Bind IsDone, Mode=TwoWay}\" />",
              "                        <TextBlock VerticalAlignment=\"Center\" Text=\"{x:Bind Title, Mode=OneWay}\" />",
              "                    </StackPanel>"
            ]
          }
        },
        {
          "id": "a23-notify-summary-on-change",
          "title": "Raise Summary when the collection changes",
          "intent": "The bound summary was static until now.",
          "covers": ["mvvm", "observable-collection"],
          "file": "ViewModels/TodoListViewModel.cs",
          "edit": {
            "op": "replace",
            "find": [
              "        foreach (var item in TodoSeed.Create())",
              "        {",
              "            Items.Add(item);",
              "        }"
            ],
            "text": [
              "        foreach (var item in TodoSeed.Create())",
              "        {",
              "            Items.Add(item);",
              "        }",
              "",
              "        Items.CollectionChanged += (_, _) => OnPropertyChanged(nameof(Summary));"
            ]
          }
        },
        {
          "id": "a24-viewmodel-cleardone",
          "title": "Add ClearDone to the view model",
          "intent": "Behaviour first; the button comes after.",
          "covers": ["mvvm", "observable-collection"],
          "file": "ViewModels/TodoListViewModel.cs",
          "edit": {
            "op": "insert-after",
            "anchor": [
              "        Items.Add(new TodoItem { Title = title.Trim() });",
              "    }"
            ],
            "text": [
              "",
              "    public void ClearDone()",
              "    {",
              "        for (var i = Items.Count - 1; i >= 0; i--)",
              "        {",
              "            if (Items[i].IsDone)",
              "            {",
              "                Items.RemoveAt(i);",
              "            }",
              "        }",
              "    }"
            ]
          }
        },
        {
          "id": "a25-cleardone-handler",
          "title": "Add the ClearDoneButton_Click handler",
          "intent": "Written before the markup that references it.",
          "covers": ["handlers"],
          "file": "MainPage.xaml.cs",
          "edit": {
            "op": "insert-after",
            "anchor": [
              "        ViewModel.AddTodo(NewTodoBox.Text);",
              "    }"
            ],
            "text": [
              "",
              "    private void ClearDoneButton_Click(object sender, RoutedEventArgs e)",
              "    {",
              "        ViewModel.ClearDone();",
              "    }"
            ]
          }
        },
        {
          "id": "a26-cleardone-button",
          "title": "Add the Clear done button to the input row",
          "intent": "Now the markup can safely reference the handler.",
          "covers": ["handlers", "x-name"],
          "file": "MainPage.xaml",
          "edit": {
            "op": "replace",
            "find": ["            <Button x:Name=\"AddButton\" Click=\"AddButton_Click\" Content=\"Add\" />"],
            "text": [
              "            <Button x:Name=\"AddButton\" Click=\"AddButton_Click\" Content=\"Add\" />",
              "            <Button",
              "                x:Name=\"ClearDoneButton\"",
              "                Click=\"ClearDoneButton_Click\"",
              "                Content=\"Clear done\" />"
            ]
          },
          "checkpoint": {
            "id": "c7-completion-works",
            "kind": "launch",
            "runtimeState": "Both rows carry a checkbox, and \"Ship the benchmark\" is already checked because it was seeded IsDone. Checking \"Buy milk\" as well and then clicking Clear done empties the list entirely and the summary re-reads \"0 of 0 done\". The list going to ZERO rather than one is the whole assertion: it is only possible if toggling the checkbox wrote IsDone back onto the TodoItem through the two-way binding.",
            "uiChecks": [
              { "target": "TodoList", "assert": "child-count-equals", "value": "2" },
              { "target": "Buy milk", "assert": "toggle-on", "note": "the row CheckBox, addressed by the AutomationId bound to Title" },
              { "target": "Buy milk", "assert": "toggle-state-equals", "value": "On", "note": "read back before clearing, so a failure to toggle is distinguishable from a failure to clear" },
              { "target": "ClearDoneButton", "assert": "invoke" },
              { "target": "TodoList", "assert": "child-count-equals", "value": "0", "note": "1 here would mean the two-way write-back did not happen" }
            ]
          }
        }
      ]
    },
