{
  "schemaVersion": "1.0",
  "id": "nested-static-enc",
  "title": "SPIKE S1/S2: the real XAML compiler on each save, its C# applied with .NET hot reload",
  "description": [
    "Each save builds the project with the real XAML compiler, applies the regenerated .g.cs through edit and continue, sends the compiler's .xbf as binary markup and re-runs InitializeComponent."
  ],
  "app": {
    "template": "app-template",
    "assetsFrom": "samples/winui-app/Assets",
    "projectFile": "TodoBench.csproj",
    "rootNamespace": "TodoBench"
  },
  "setup": [
    {
      "id": "setup-window",
      "title": "A window hosting a Frame",
      "file": "MainWindow.xaml",
      "edit": {
        "op": "create-file",
        "text": [
          "<?xml version=\"1.0\" encoding=\"utf-8\" ?>",
          "<Window x:Class=\"TodoBench.MainWindow\" xmlns=\"http://schemas.microsoft.com/winfx/2006/xaml/presentation\"",
          "    xmlns:x=\"http://schemas.microsoft.com/winfx/2006/xaml\"",
          "    xmlns:local=\"using:TodoBench\" Title=\"TodoBench\">",
          "    <Frame x:Name=\"Root\" />",
          "</Window>"
        ]
      }
    },
    {
      "id": "setup-window-code",
      "title": "It navigates to MainPage",
      "file": "MainWindow.xaml.cs",
      "edit": {
        "op": "create-file",
        "text": [
          "using Microsoft.UI.Xaml;",
          "",
          "namespace TodoBench;",
          "",
          "public sealed partial class MainWindow : Window",
          "{",
          "    public MainWindow()",
          "    {",
          "        InitializeComponent();",
          "        Root.Navigate(typeof(MainPage));",
          "    }",
          "}"
        ]
      }
    },
    {
      "id": "setup-models",
      "title": "A view model with change notification, items, a static formatter",
      "file": "Models.cs",
      "edit": {
        "op": "create-file",
        "text": [
          "using System.Collections.ObjectModel;",
          "using System.ComponentModel;",
          "using System.Runtime.CompilerServices;",
          "",
          "namespace TodoBench;",
          "",
          "public class ItemBase",
          "{",
          "    public string Name { get; set; } = \"\";",
          "}",
          "",
          "public sealed class Item : ItemBase",
          "{",
          "    public int Price { get; set; }",
          "}",
          "",
          "public static class Fmt",
          "{",
          "    public static string Twice(int value) => $\"twice {value * 2}\";",
          "}",
          "",
          "public sealed class MainViewModel : INotifyPropertyChanged",
          "{",
          "    public event PropertyChangedEventHandler? PropertyChanged;",
          "",
          "    private string _title = \"Hello\";",
          "    private int _count;",
          "    private bool _showLazy;",
          "",
          "    public string Title { get => _title; set { _title = value; Raise(); } }",
          "    public string Subtitle => \"Sub\";",
          "    public int Count { get => _count; set { _count = value; Raise(); } }",
          "    public bool ShowLazy { get => _showLazy; set { _showLazy = value; Raise(); } }",
          "    public ObservableCollection<Item> Items { get; } = [new() { Name = \"Apple\", Price = 1 }, new() { Name = \"Banana\", Price = 2 }];",
          "",
          "    private void Raise([CallerMemberName] string? name = null) => PropertyChanged?.Invoke(this, new PropertyChangedEventArgs(name));",
          "}"
        ]
      }
    },
    {
      "id": "setup-page",
      "title": "A page with no x:Bind yet",
      "file": "MainPage.xaml",
      "edit": {
        "op": "create-file",
        "text": [
          "<?xml version=\"1.0\" encoding=\"utf-8\" ?>",
          "<Page x:Class=\"TodoBench.MainPage\" xmlns=\"http://schemas.microsoft.com/winfx/2006/xaml/presentation\"",
          "    xmlns:x=\"http://schemas.microsoft.com/winfx/2006/xaml\"",
          "    xmlns:local=\"using:TodoBench\">",
          "    <StackPanel x:Name=\"Panel\" Spacing=\"6\" Margin=\"16\">",
          "        <TextBlock x:Name=\"Status\" AutomationProperties.AutomationId=\"Status\" Text=\"ready\" />",
          "        <Button x:Name=\"ExistingBtn\" AutomationProperties.AutomationId=\"ExistingBtn\" Content=\"Existing\" />",
          "        <Button x:Name=\"IncBtn\" AutomationProperties.AutomationId=\"IncBtn\" Content=\"Increment\" Click=\"Inc_Click\" />",
          "        <Button x:Name=\"ProbeBtn\" AutomationProperties.AutomationId=\"ProbeBtn\" Content=\"Probe\" Click=\"Probe_Click\" />",
          "        <Button x:Name=\"ToggleBtn\" AutomationProperties.AutomationId=\"ToggleBtn\" Content=\"Toggle\" Click=\"Toggle_Click\" />",
          "        <TextBlock AutomationProperties.AutomationId=\"LaterText\" Text=\"named later\" />",
          "        <ComboBox x:Name=\"Picker\" AutomationProperties.AutomationId=\"Picker\" SelectedIndex=\"0\">",
          "            <x:String>First</x:String>",
          "            <x:String>Second</x:String>",
          "        </ComboBox>",
          "        <TextBlock AutomationProperties.AutomationId=\"Plain\" Text=\"plain v1\" />",
          "    </StackPanel>",
          "</Page>"
        ]
      }
    },
    {
      "id": "setup-page-code",
      "title": "Its code-behind",
      "file": "MainPage.xaml.cs",
      "edit": {
        "op": "create-file",
        "text": [
          "using Microsoft.UI.Xaml;",
          "using Microsoft.UI.Xaml.Controls;",
          "",
          "namespace TodoBench;",
          "",
          "public sealed partial class MainPage : Page",
          "{",
          "    public MainViewModel ViewModel { get; } = new();",
          "",
          "    public MainPage()",
          "    {",
          "        InitializeComponent();",
          "    }",
          "",
          "    private void Existing_Click(object sender, RoutedEventArgs e) => Status.Text = \"existing clicked\";",
          "",
          "    private void Inc_Click(object sender, RoutedEventArgs e) => ViewModel.Count++;",
          "",
          "    private void Probe_Click(object sender, RoutedEventArgs e) => Status.Text = \"probe\";",
          "",
          "    private void Toggle_Click(object sender, RoutedEventArgs e) => ViewModel.ShowLazy = !ViewModel.ShowLazy;",
          "}"
        ]
      }
    }
  ],
  "dimensions": [],
  "variants": [
    {
      "id": "default",
      "primary": true,
      "summary": "default",
      "choices": {}
    }
  ],
  "segments": [
    {
      "kind": "common",
      "phase": "spike",
      "title": "spike",
      "actions": [
        {
          "id": "n1-add-nested",
          "title": "Add a nested class with a field and a method",
          "file": "MainPage.xaml.cs",
          "edit": {
            "op": "replace",
            "find": [
              "    private void Probe_Click(object sender, RoutedEventArgs e) => Status.Text = \"probe\";"
            ],
            "text": [
              "    private void Probe_Click(object sender, RoutedEventArgs e) => Status.Text = new Helper().Value();",
              "",
              "    private class Helper",
              "    {",
              "        private static bool s_a = false;",
              "        private int _a = 1;",
              "        public string Value() => \"v\" + _a + s_a;",
              "    }"
            ]
          },
          "checkpoint": {
            "id": "c-n1",
            "kind": "live",
            "uiChecks": [
              {
                "target": "ProbeBtn",
                "assert": "invoke"
              },
              {
                "target": "Status",
                "assert": "text-equals",
                "value": "v1False"
              }
            ]
          },
          "expect": {
            "outcome": "applied"
          }
        },
        {
          "id": "n2-edit-nested",
          "title": "Edit the nested class: a new field, a changed method",
          "file": "MainPage.xaml.cs",
          "edit": {
            "op": "replace",
            "find": [
              "        private int _a = 1;",
              "        public string Value() => \"v\" + _a + s_a;"
            ],
            "text": [
              "        private static bool s_b = false;",
              "        private int _a = 1;",
              "        public string Value() => \"v\" + _a + s_a + s_b;"
            ]
          },
          "checkpoint": {
            "id": "c-n2",
            "kind": "live",
            "uiChecks": [
              {
                "target": "ProbeBtn",
                "assert": "invoke"
              },
              {
                "target": "Status",
                "assert": "text-equals",
                "value": "v1FalseFalse"
              }
            ]
          },
          "expect": {
            "outcome": "applied"
          }
        },
        {
          "id": "n3-edit-again",
          "title": "Edit the nested method again",
          "file": "MainPage.xaml.cs",
          "edit": {
            "op": "replace",
            "find": [
              "        public string Value() => \"v\" + _a + s_a + s_b;"
            ],
            "text": [
              "        public string Value() => \"w\" + _a + s_a + s_b;"
            ]
          },
          "checkpoint": {
            "id": "c-n3",
            "kind": "live",
            "uiChecks": [
              {
                "target": "ProbeBtn",
                "assert": "invoke"
              },
              {
                "target": "Status",
                "assert": "text-equals",
                "value": "w1FalseFalse"
              }
            ]
          },
          "expect": {
            "outcome": "applied"
          }
        }
      ]
    }
  ]
}
