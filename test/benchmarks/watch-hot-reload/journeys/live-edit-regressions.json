          "id": "r30-fmt",
          "title": "N5: an x:Bind function",
          "file": "Fmt.cs",
          "edit": {
            "op": "create-file",
            "text": [
              "namespace TodoBench;",
              "",
              "public static class Fmt",
              "{",
              "    public static string Tag(string s) => \"[\" + s + \"]\";",
              "}"
            ]
          }
