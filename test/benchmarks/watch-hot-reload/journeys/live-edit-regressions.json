{
  "schemaVersion": "1.0",
  "id": "live-edit-regressions",
  "title": "Saves an independent tester found reported as applied while the app was wrong, or restarted",
  "description": [
    "Element-rooted x:Bind, a page created while running, invalid x:Bind paths, typed text across window and failed reloads, the NavigationView shell, runtime parse errors, cached pages, UpdateSourceTrigger, startup-only edits, constructor timers, new and overwritten assets, x:Bind function bodies, Application settings and removed packages."
  ],
  "app": {
    "template": "app-template",
    "assetsFrom": "samples/winui-app/Assets",
    "projectFile": "TodoBench.csproj",
    "rootNamespace": "TodoBench"
  },
  "dimensions": [],
  "variants": [
    {
      "id": "default",
      "primary": true,
      "summary": "default",
      "choices": {}
    }
  ],
  "segments": [
    {
      "kind": "common",
      "phase": "regressions",
      "title": "regressions",
      "actions": [
        {
          "id": "r01-greeter",
          "title": "View model for two-way binding",
          "file": "Greeter.cs",
          "edit": {
            "op": "create-file",
            "text": [
              "using System.ComponentModel;",
              "",
              "namespace TodoBench;",
              "",
              "public sealed class Greeter : INotifyPropertyChanged",
              "{",
              "    private string _greeting = \"hi\";",
              "",
              "    public string Greeting",
              "    {",
              "        get => _greeting;",
              "        set { _greeting = value; PropertyChanged?.Invoke(this, new PropertyChangedEventArgs(nameof(Greeting))); }",
              "    }",
              "",
              "    public event PropertyChangedEventHandler? PropertyChanged;",
              "}"
            ]
          }
        },
        {
          "id": "r02-home-xaml",
          "title": "New page markup (created while running)",
          "file": "HomePage.xaml",
          "edit": {
            "op": "create-file",
            "text": [
              "<?xml version=\"1.0\" encoding=\"utf-8\" ?>",
              "<Page",
              "    x:Class=\"TodoBench.HomePage\"",
              "    xmlns=\"http://schemas.microsoft.com/winfx/2006/xaml/presentation\"",
              "    xmlns:x=\"http://schemas.microsoft.com/winfx/2006/xaml\">",
              "    <StackPanel Spacing=\"8\" Margin=\"16\">",
              "        <TextBox",
              "            x:Name=\"NotesBox\"",
              "            AutomationProperties.AutomationId=\"NotesBox\"",
              "            Width=\"240\"",
              "            HorizontalAlignment=\"Left\" />",
              "        <TextBlock AutomationProperties.AutomationId=\"NotesEcho\" Text=\"{x:Bind NotesBox.Text, Mode=OneWay}\" />",
              "        <TextBox",
              "            AutomationProperties.AutomationId=\"GreetBox\"",
              "            Width=\"240\"",
              "            HorizontalAlignment=\"Left\"",
              "            Text=\"{x:Bind Greeter.Greeting, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}\" />",
              "        <TextBlock AutomationProperties.AutomationId=\"GreetEcho\" Text=\"{x:Bind Greeter.Greeting, Mode=OneWay}\" />",
              "        <Button x:Name=\"PingButton\" AutomationProperties.AutomationId=\"PingButton\" Content=\"Ping\" Click=\"Ping_Click\" />",
              "        <TextBlock x:Name=\"PingText\" AutomationProperties.AutomationId=\"PingText\" Text=\"idle\" />",
              "        <TextBlock AutomationProperties.AutomationId=\"HomeLabel\" Text=\"home v1\" Foreground=\"Gold\" />",
              "    </StackPanel>",
              "</Page>"
            ]
          }
        },
        {
          "id": "r03-home-code",
          "title": "New page code-behind",
          "file": "HomePage.xaml.cs",
          "edit": {
            "op": "create-file",
            "text": [
              "using Microsoft.UI.Xaml;",
              "using Microsoft.UI.Xaml.Controls;",
              "",
              "namespace TodoBench;",
              "",
              "public sealed partial class HomePage : Page",
              "{",
              "    public Greeter Greeter { get; } = new();",
              "",
              "    public HomePage()",
              "    {",
              "        InitializeComponent();",
              "    }",
              "",
              "    private void Ping_Click(object sender, RoutedEventArgs e)",
              "    {",
              "        PingText.Text = \"pong 1\";",
              "    }",
              "}"
            ]
          }
        },
        {
          "id": "r04-cached-xaml",
          "title": "Page kept in the Frame cache",
          "file": "CachedPage.xaml",
          "edit": {
            "op": "create-file",
            "text": [
              "<?xml version=\"1.0\" encoding=\"utf-8\" ?>",
              "<Page",
              "    x:Class=\"TodoBench.CachedPage\"",
              "    xmlns=\"http://schemas.microsoft.com/winfx/2006/xaml/presentation\"",
              "    xmlns:x=\"http://schemas.microsoft.com/winfx/2006/xaml\"",
              "    NavigationCacheMode=\"Required\">",
              "    <StackPanel Spacing=\"8\" Margin=\"16\">",
              "        <TextBlock AutomationProperties.AutomationId=\"CachedText\" Text=\"cached v1\" />",
              "        <TextBox AutomationProperties.AutomationId=\"CachedBox\" Width=\"240\" HorizontalAlignment=\"Left\" />",
              "    </StackPanel>",
              "</Page>"
            ]
          }
        },
        {
          "id": "r05-cached-code",
          "title": "Cached page code-behind",
          "file": "CachedPage.xaml.cs",
          "edit": {
            "op": "create-file",
            "text": [
              "using Microsoft.UI.Xaml.Controls;",
              "",
              "namespace TodoBench;",
              "",
              "public sealed partial class CachedPage : Page",
              "{",
              "    public CachedPage()",
              "    {",
              "        InitializeComponent();",
              "    }",
              "}"
            ]
          }
        },
        {
          "id": "r06-shell-code",
          "title": "Shell navigation handler",
          "file": "MainWindow.xaml.cs",
          "edit": {
            "op": "create-file",
            "text": [
              "using Microsoft.UI.Xaml;",
              "using Microsoft.UI.Xaml.Controls;",
              "",
              "namespace TodoBench;",
              "",
              "public sealed partial class MainWindow : Window",
              "{",
              "    public MainWindow()",
              "    {",
              "        InitializeComponent();",
              "    }",
              "",
              "    private void NavView_SelectionChanged(NavigationView sender, NavigationViewSelectionChangedEventArgs args)",
              "    {",
              "        var page = (args.SelectedItem as NavigationViewItem)?.Tag as string == \"cached\" ? typeof(CachedPage) : typeof(HomePage);",
              "        if (NavFrame.CurrentSourcePageType != page)",
              "        {",
              "            NavFrame.Navigate(page);",
              "        }",
              "    }",
              "}"
            ]
          }
        },
        {
          "id": "r07-shell-xaml",
          "title": "NavigationView shell with an element-rooted x:Bind",
          "file": "MainWindow.xaml",
          "edit": {
            "op": "create-file",
            "text": [
              "<?xml version=\"1.0\" encoding=\"utf-8\" ?>",
              "<Window",
              "    x:Class=\"TodoBench.MainWindow\"",
              "    xmlns=\"http://schemas.microsoft.com/winfx/2006/xaml/presentation\"",
              "    xmlns:x=\"http://schemas.microsoft.com/winfx/2006/xaml\"",
              "    Title=\"TodoBench\">",
              "    <Grid>",
              "        <Grid.RowDefinitions>",
              "            <RowDefinition Height=\"Auto\" />",
              "            <RowDefinition Height=\"*\" />",
              "        </Grid.RowDefinitions>",
              "        <StackPanel Orientation=\"Horizontal\" Spacing=\"8\" Margin=\"8\">",
              "            <TextBlock AutomationProperties.AutomationId=\"BackState\" Text=\"{x:Bind NavFrame.CanGoBack, Mode=OneWay}\" />",
              "            <TextBlock AutomationProperties.AutomationId=\"ShellLabel\" Text=\"shell v1\" />",
              "        </StackPanel>",
              "        <NavigationView",
              "            x:Name=\"NavView\"",
              "            Grid.Row=\"1\"",
              "            IsSettingsVisible=\"False\"",
              "            IsBackButtonVisible=\"Collapsed\"",
              "            SelectionChanged=\"NavView_SelectionChanged\">",
              "            <NavigationView.MenuItems>",
              "                <NavigationViewItem Content=\"Home\" Tag=\"home\" IsSelected=\"True\" AutomationProperties.AutomationId=\"HomeNav\" />",
              "                <NavigationViewItem Content=\"Cached\" Tag=\"cached\" AutomationProperties.AutomationId=\"CachedNav\" />",
              "            </NavigationView.MenuItems>",
              "            <Frame x:Name=\"NavFrame\" />",
              "        </NavigationView>",
              "    </Grid>",
              "</Window>"
            ]
          },
          "checkpoint": {
            "id": "c-r07-shell-xaml",
            "kind": "live",
            "uiChecks": [
              {
                "target": "NotesBox",
                "assert": "exists"
              },
              {
                "target": "BackState",
                "assert": "text-equals",
                "value": "False"
              }
            ]
          }
        },
