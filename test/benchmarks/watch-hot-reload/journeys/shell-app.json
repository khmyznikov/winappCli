        {
          "id": "s03b-cast-path-typo",
          "title": "A typo in the path a cast reads is an error at its line, as the XAML compiler reports it",
          "file": "OptionsPage.xaml",
          "edit": {
            "op": "replace",
            "find": [
              "((ComboBoxItem)Sizes.SelectedItem)"
            ],
            "text": [
              "((ComboBoxItem)SizesX.SelectedItem)"
            ]
          },
          "expect": {
            "outcome": "error",
