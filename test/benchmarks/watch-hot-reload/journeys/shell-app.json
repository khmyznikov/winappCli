{
  "schemaVersion": "1.0",
  "id": "shell-app",
  "title": "A shell window like the galleries': a constructor argument, menu items from startup code, nullable x:Bind paths",
  "description": [
    "Real apps build their shell in App.OnLaunched: the window takes an argument and startup code fills its menu. Reloads keep that state (menu items code added, values the constructor set, a frame inside a page and what was typed there), x:Bind through a nullable IsChecked.Value keeps working after a page reload, App.xaml errors point at the user's file, data files the build copies reach the running app, and edits that only take effect at restart say so."
  ],
  "app": {
    "template": "app-template",
    "assetsFrom": "samples/winui-app/Assets",
    "projectFile": "TodoBench.csproj",
    "rootNamespace": "TodoBench"
  },
  "setup": [
    {
      "id": "setup-app",
      "title": "App.OnLaunched passes the window an argument and fills its menu",
      "file": "App.xaml.cs",
      "edit": {
        "op": "create-file",
        "text": [
          "using Microsoft.UI.Xaml;",
          "",
          "namespace TodoBench;",
          "",
          "public partial class App : Application",
          "{",
          "    private MainWindow? _window;",
          "",
          "    public App()",
          "    {",
          "        InitializeComponent();",
          "    }",
          "",
          "    protected override void OnLaunched(LaunchActivatedEventArgs args)",
          "    {",
          "        // A shell like WinUI Gallery's or AI Dev Gallery's: the window takes an argument, and startup code fills its menu.",
          "        _window = new MainWindow(\"from launch\");",
          "        _window.AddNavigationItems([\"Alpha\", \"Beta\", \"Gamma\"]);",
          "        _window.Activate();",
          "    }",
          "}"
        ]
      }
    },
    {
      "id": "setup-window",
      "title": "A shell window: a NavigationView around a Frame",
      "file": "MainWindow.xaml",
      "edit": {
        "op": "create-file",
        "text": [
          "<?xml version=\"1.0\" encoding=\"utf-8\" ?>",
          "<Window",
          "    x:Class=\"TodoBench.MainWindow\"",
          "    xmlns=\"http://schemas.microsoft.com/winfx/2006/xaml/presentation\"",
          "    xmlns:x=\"http://schemas.microsoft.com/winfx/2006/xaml\"",
          "    Title=\"TodoBench\">",
          "    <NavigationView x:Name=\"Nav\" PaneDisplayMode=\"Left\" IsPaneOpen=\"True\" IsSettingsVisible=\"False\" IsBackButtonVisible=\"Collapsed\" SelectionChanged=\"Nav_SelectionChanged\">",
          "        <NavigationView.MenuItems>",
          "            <NavigationViewItem Content=\"Home\" AutomationProperties.AutomationId=\"NavHome\" />",
          "        </NavigationView.MenuItems>",
          "        <NavigationView.FooterMenuItems>",
          "            <NavigationViewItem Content=\"Help\" AutomationProperties.AutomationId=\"NavHelp\" />",
          "        </NavigationView.FooterMenuItems>",
          "        <StackPanel Spacing=\"8\" Margin=\"16\">",
          "            <TextBlock AutomationProperties.AutomationId=\"Label\" Text=\"shell v1\" />",
          "            <TextBlock x:Name=\"Selected\" AutomationProperties.AutomationId=\"Selected\" Text=\"nothing selected\" />",
          "            <TextBlock x:Name=\"Status\" AutomationProperties.AutomationId=\"Status\" Text=\"status from markup\" />",
          "            <Button AutomationProperties.AutomationId=\"Count\" Content=\"Count\" Click=\"Count_Click\" />",
          "            <TextBlock x:Name=\"CountText\" AutomationProperties.AutomationId=\"CountText\" Text=\"not counted\" />",
          "            <Button AutomationProperties.AutomationId=\"ReadData\" Content=\"Read data\" Click=\"ReadData_Click\" />",
          "            <TextBlock x:Name=\"DataText\" AutomationProperties.AutomationId=\"DataText\" Text=\"not read\" />",
          "            <Button AutomationProperties.AutomationId=\"Go\" Content=\"Go\" Click=\"Go_Click\" />",
          "            <Button AutomationProperties.AutomationId=\"Back\" Content=\"Back\" IsEnabled=\"{x:Bind Body.CanGoBack, Mode=OneWay}\" />",
          "            <Frame x:Name=\"Body\" />",
          "        </StackPanel>",
          "    </NavigationView>",
          "</Window>"
        ]
      }
    },
    {
      "id": "setup-window-code",
      "title": "Its constructor takes an argument; code adds menu items",
      "file": "MainWindow.xaml.cs",
      "edit": {
        "op": "create-file",
        "text": [
          "using Microsoft.UI.Xaml;",
          "using Microsoft.UI.Xaml.Automation;",
          "using Microsoft.UI.Xaml.Controls;",
          "",
          "namespace TodoBench;",
          "",
          "public sealed partial class MainWindow : Window",
          "{",
          "    public MainWindow(object? argument = null)",
          "    {",
          "        InitializeComponent();",
          "        Title = $\"TodoBench ({argument})\";",
          "        // Set by the constructor (like a title bar subtitle), and a footer item added in code.",
          "        Status.Text = \"status from constructor\";",
          "        var feedback = new NavigationViewItem { Content = \"Feedback\" };",
          "        AutomationProperties.SetAutomationId(feedback, \"NavFeedback\");",
          "        Nav.FooterMenuItems.Add(feedback);",
          "        Body.Navigate(typeof(OptionsPage));",
          "        // Evaluates x:Bind now (a common pattern), so a reload evaluates it before the kept frame is back in Body.",
          "        Bindings.Update();",
          "    }",
          "",
          "    private void Count_Click(object sender, RoutedEventArgs e)",
          "    {",
          "        CountText.Text = $\"{Nav.MenuItems.Count}/{Nav.FooterMenuItems.Count}\";",
          "    }",
          "",
          "    private void ReadData_Click(object sender, RoutedEventArgs e)",
          "    {",
          "        DataText.Text = System.IO.File.ReadAllText(System.IO.Path.Combine(System.AppContext.BaseDirectory, \"data.json\")).Trim();",
          "    }",
          "",
          "    // Another instance of the same page, so the frame can go back.",
          "    private void Go_Click(object sender, RoutedEventArgs e)",
          "    {",
          "        Body.Navigate(typeof(OptionsPage));",
          "    }",
          "",
          "    public void AddNavigationItems(string[] names)",
          "    {",
          "        foreach (var name in names)",
          "        {",
          "            var item = new NavigationViewItem { Content = name, IsExpanded = true };",
          "            AutomationProperties.SetAutomationId(item, \"Nav\" + name);",
          "            // Nested items, like a gallery's categories and their pages.",
          "            var child = new NavigationViewItem { Content = name + \" 1\" };",
          "            AutomationProperties.SetAutomationId(child, \"Nav\" + name + \"1\");",
          "            item.MenuItems.Add(child);",
          "            Nav.MenuItems.Add(item);",
          "        }",
          "    }",
          "",
          "    private void Nav_SelectionChanged(NavigationView sender, NavigationViewSelectionChangedEventArgs args)",
          "    {",
          "        Selected.Text = args.SelectedItemContainer?.Content as string ?? \"no container\";",
          "    }",
          "}"
        ]
      }
    },
    {
      "id": "setup-page",
      "title": "A page binding through a CheckBox's nullable IsChecked.Value",
      "file": "OptionsPage.xaml",
      "edit": {
        "op": "create-file",
        "text": [
          "<?xml version=\"1.0\" encoding=\"utf-8\" ?>",
          "<Page",
          "    x:Class=\"TodoBench.OptionsPage\"",
          "    xmlns:local=\"using:TodoBench\"",
          "    xmlns=\"http://schemas.microsoft.com/winfx/2006/xaml/presentation\"",
          "    xmlns:x=\"http://schemas.microsoft.com/winfx/2006/xaml\">",
          "    <StackPanel Spacing=\"8\">",
          "        <TextBlock AutomationProperties.AutomationId=\"Heading\" Text=\"options v1\" />",
          "        <CheckBox x:Name=\"Disable\" Content=\"Disable\" />",
          "        <Button x:Name=\"Target\" Content=\"Target\" IsEnabled=\"{x:Bind Disable.IsChecked.Value.Equals(x:False), Mode=OneWay}\" />",
          "        <CheckBox x:Name=\"Mirror\" Content=\"Mirror\" IsChecked=\"{x:Bind Disable.IsChecked.Value, Mode=OneWay}\" />",
          "        <ComboBox x:Name=\"Picker\" DisplayMemberPath=\"Name\" SelectedIndex=\"0\">",
          "            <local:Choice Name=\"First\" />",
          "            <local:Choice Name=\"Second\" />",
          "        </ComboBox>",
          "        <TextBlock AutomationProperties.AutomationId=\"PickedName\" Text=\"{x:Bind ((local:Choice)Picker.SelectedItem).Name, Mode=OneWay}\" />",
          "        <ComboBox x:Name=\"Sizes\" SelectedIndex=\"0\">",
          "            <ComboBoxItem x:Name=\"SizeSmall\" Content=\"Small\" />",
          "            <ComboBoxItem x:Name=\"SizeLarge\" Content=\"Large\" />",
          "        </ComboBox>",
          "        <TextBlock AutomationProperties.AutomationId=\"PickedSize\" Text=\"{x:Bind ((ComboBoxItem)Sizes.SelectedItem).Name, Mode=OneWay}\" />",
          "        <ComboBox x:Name=\"FontPicker\" ItemsSource=\"{x:Bind FontSizes}\" Loaded=\"FontPicker_Loaded\" />",
          "        <TextBlock x:Name=\"Sized\" Text=\"sized\" FontSize=\"{x:Bind (x:Double)FontPicker.SelectedValue, Mode=OneWay}\" />",
          "        <ListView x:Name=\"BarList\" ItemsSource=\"{x:Bind Bars}\" />",
          "        <Button AutomationProperties.AutomationId=\"AddBar\" Content=\"Add bar\" Click=\"AddBar_Click\" />",
          "        <local:Echo>",
          "            <local:Echo.Values>",
          "                <local:EchoValue Value=\"{x:Bind Disable.IsChecked, Mode=OneWay}\" />",
          "            </local:Echo.Values>",
          "        </local:Echo>",
          "        <Frame x:Name=\"Inner\" />",
          "    </StackPanel>",
          "</Page>"
        ]
      }
    },
    {
      "id": "setup-page-code",
      "title": "Its code-behind, which shows an inner page in a frame of its own",
      "file": "OptionsPage.xaml.cs",
      "edit": {
        "op": "create-file",
        "text": [
          "using Microsoft.UI.Xaml.Controls;",
          "",
          "namespace TodoBench;",
          "",
          "public sealed partial class OptionsPage : Page",
          "{",
          "    public OptionsPage()",
          "    {",
          "        InitializeComponent();",
          "        Fill();",
          "    }",
          "",
          "    // Like WinUI Gallery's ItemsRepeaterPage: a constructor helper fills a collection the page shows.",
          "    public System.Collections.ObjectModel.ObservableCollection<string> Bars = new();",
          "",
          "    private void Fill()",
          "    {",
          "        Bars.Add(\"one\");",
          "        Bars.Add(\"two\");",
          "        Bars.Add(\"three\");",
          "    }",
          "",
          "    private void AddBar_Click(object sender, Microsoft.UI.Xaml.RoutedEventArgs e)",
          "    {",
          "        Bars.Add(\"added \" + Bars.Count);",
          "    }",
          "",
          "    // Like WinUI Gallery's ComboBox page: sizes in a List<double>, the selection made once the box has loaded.",
          "    public System.Collections.Generic.List<double> FontSizes { get; } = new System.Collections.Generic.List<double> { 12, 20, 28 };",
          "",
          "    private void FontPicker_Loaded(object sender, Microsoft.UI.Xaml.RoutedEventArgs e)",
          "    {",
          "        FontPicker.SelectedIndex = 1;",
          "    }",
          "",
          "    // Like a gallery's item page, which shows its sample in a frame of its own.",
          "    protected override void OnNavigatedTo(Microsoft.UI.Xaml.Navigation.NavigationEventArgs e)",
          "    {",
          "        Inner.Navigate(typeof(InnerPage));",
          "    }",
          "}",
          "",
          "// An item type the page's x:Bind casts to.",
          "public sealed partial class Choice",
          "{",
          "    public string Name { get; set; } = \"\";",
          "}"
        ]
      }
    },
    {
      "id": "setup-echo",
      "title": "A panel showing values of non-visual objects with a plain .NET property (like ControlExampleSubstitution)",
      "file": "Echo.cs",
      "edit": {
        "op": "create-file",
        "text": [
          "using Microsoft.UI.Xaml.Controls;",
          "",
          "namespace TodoBench;",
          "",
          "// Like WinUI Gallery's ControlExampleSubstitution: a non-visual object with a plain .NET property set by x:Bind.",
          "public sealed partial class EchoValue : Microsoft.UI.Xaml.DependencyObject",
          "{",
          "    private object? _value;",
          "    public event System.EventHandler? ValueChanged;",
          "",
          "    public object? Value",
          "    {",
          "        get => _value;",
          "        set { _value = value; ValueChanged?.Invoke(this, System.EventArgs.Empty); }",
          "    }",
          "}",
          "",
          "// Shows its values, like the gallery's code sample showing its substitutions.",
          "public sealed partial class Echo : StackPanel",
          "{",
          "    public static readonly Microsoft.UI.Xaml.DependencyProperty ValuesProperty = Microsoft.UI.Xaml.DependencyProperty.Register(",
          "        nameof(Values), typeof(System.Collections.Generic.IList<EchoValue>), typeof(Echo), new Microsoft.UI.Xaml.PropertyMetadata(null));",
          "",
          "    private readonly TextBlock _text = new();",
          "",
          "    public Echo()",
          "    {",
          "        Values = new System.Collections.Generic.List<EchoValue>();",
          "        Microsoft.UI.Xaml.Automation.AutomationProperties.SetAutomationId(_text, \"EchoText\");",
          "        Children.Add(_text);",
          "        Loaded += (_, _) =>",
          "        {",
          "            foreach (var value in Values)",
          "            {",
          "                value.ValueChanged -= Render;",
          "                value.ValueChanged += Render;",
          "            }",
          "            Render(this, System.EventArgs.Empty);",
          "        };",
          "    }",
          "",
          "    public System.Collections.Generic.IList<EchoValue> Values",
          "    {",
          "        get => (System.Collections.Generic.IList<EchoValue>)GetValue(ValuesProperty);",
          "        set => SetValue(ValuesProperty, value);",
          "    }",
          "",
          "    private void Render(object? sender, System.EventArgs e) =>",
          "        _text.Text = \"echo:\" + string.Join(\",\", System.Linq.Enumerable.Select(Values, v => v.Value?.ToString() ?? \"\"));",
          "}"
        ]
      }
    },
