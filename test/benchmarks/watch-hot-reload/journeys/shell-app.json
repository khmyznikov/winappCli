{
  "schemaVersion": "1.0",
  "id": "shell-app",
  "title": "A shell window like the galleries': a constructor argument, menu items from startup code, nullable x:Bind paths",
  "description": [
    "Real apps build their shell in App.OnLaunched: the window takes an argument and startup code fills its menu. Reloads keep that state, x:Bind through a nullable IsChecked.Value keeps working after a page reload, App.xaml errors point at the user's file, and edits that only take effect at restart say so."
  ],
  "app": {
    "template": "app-template",
    "assetsFrom": "samples/winui-app/Assets",
    "projectFile": "TodoBench.csproj",
    "rootNamespace": "TodoBench"
  },
  "setup": [
    {
      "id": "setup-app",
      "title": "App.OnLaunched passes the window an argument and fills its menu",
      "file": "App.xaml.cs",
      "edit": {
        "op": "create-file",
        "text": [
          "using Microsoft.UI.Xaml;",
          "",
          "namespace TodoBench;",
          "",
          "public partial class App : Application",
          "{",
          "    private MainWindow? _window;",
          "",
          "    public App()",
          "    {",
          "        InitializeComponent();",
          "    }",
          "",
          "    protected override void OnLaunched(LaunchActivatedEventArgs args)",
          "    {",
          "        // A shell like WinUI Gallery's or AI Dev Gallery's: the window takes an argument, and startup code fills its menu.",
          "        _window = new MainWindow(\"from launch\");",
          "        _window.AddNavigationItems([\"Alpha\", \"Beta\", \"Gamma\"]);",
          "        _window.Activate();",
          "    }",
          "}"
        ]
      }
    },
    {
      "id": "setup-window",
      "title": "A shell window: a NavigationView around a Frame",
      "file": "MainWindow.xaml",
      "edit": {
        "op": "create-file",
        "text": [
          "<?xml version=\"1.0\" encoding=\"utf-8\" ?>",
          "<Window",
          "    x:Class=\"TodoBench.MainWindow\"",
          "    xmlns=\"http://schemas.microsoft.com/winfx/2006/xaml/presentation\"",
          "    xmlns:x=\"http://schemas.microsoft.com/winfx/2006/xaml\"",
          "    Title=\"TodoBench\">",
          "    <NavigationView x:Name=\"Nav\" PaneDisplayMode=\"Left\" IsPaneOpen=\"True\" IsSettingsVisible=\"False\" IsBackButtonVisible=\"Collapsed\" SelectionChanged=\"Nav_SelectionChanged\">",
          "        <NavigationView.MenuItems>",
          "            <NavigationViewItem Content=\"Home\" AutomationProperties.AutomationId=\"NavHome\" />",
          "        </NavigationView.MenuItems>",
          "        <StackPanel Spacing=\"8\" Margin=\"16\">",
          "            <TextBlock AutomationProperties.AutomationId=\"Label\" Text=\"shell v1\" />",
          "            <TextBlock x:Name=\"Selected\" AutomationProperties.AutomationId=\"Selected\" Text=\"nothing selected\" />",
          "            <Frame x:Name=\"Body\" />",
          "        </StackPanel>",
          "    </NavigationView>",
          "</Window>"
        ]
      }
    },
    {
      "id": "setup-window-code",
      "title": "Its constructor takes an argument; code adds menu items",
      "file": "MainWindow.xaml.cs",
      "edit": {
        "op": "create-file",
        "text": [
          "using Microsoft.UI.Xaml;",
          "using Microsoft.UI.Xaml.Automation;",
          "using Microsoft.UI.Xaml.Controls;",
          "",
          "namespace TodoBench;",
          "",
          "public sealed partial class MainWindow : Window",
          "{",
          "    public MainWindow(object? argument = null)",
          "    {",
          "        InitializeComponent();",
          "        Title = $\"TodoBench ({argument})\";",
          "        Body.Navigate(typeof(OptionsPage));",
          "    }",
          "",
          "    public void AddNavigationItems(string[] names)",
          "    {",
          "        foreach (var name in names)",
          "        {",
          "            var item = new NavigationViewItem { Content = name, IsExpanded = true };",
          "            AutomationProperties.SetAutomationId(item, \"Nav\" + name);",
          "            // Nested items, like a gallery's categories and their pages.",
          "            var child = new NavigationViewItem { Content = name + \" 1\" };",
          "            AutomationProperties.SetAutomationId(child, \"Nav\" + name + \"1\");",
          "            item.MenuItems.Add(child);",
          "            Nav.MenuItems.Add(item);",
          "        }",
          "    }",
          "",
          "    private void Nav_SelectionChanged(NavigationView sender, NavigationViewSelectionChangedEventArgs args)",
          "    {",
          "        Selected.Text = args.SelectedItemContainer?.Content as string ?? \"no container\";",
          "    }",
          "}"
        ]
      }
    },
    {
      "id": "setup-page",
      "title": "A page binding through a CheckBox's nullable IsChecked.Value",
      "file": "OptionsPage.xaml",
      "edit": {
        "op": "create-file",
        "text": [
          "<?xml version=\"1.0\" encoding=\"utf-8\" ?>",
          "<Page",
          "    x:Class=\"TodoBench.OptionsPage\"",
          "    xmlns=\"http://schemas.microsoft.com/winfx/2006/xaml/presentation\"",
          "    xmlns:x=\"http://schemas.microsoft.com/winfx/2006/xaml\">",
          "    <StackPanel Spacing=\"8\">",
          "        <TextBlock AutomationProperties.AutomationId=\"Heading\" Text=\"options v1\" />",
          "        <CheckBox x:Name=\"Disable\" Content=\"Disable\" />",
          "        <Button x:Name=\"Target\" Content=\"Target\" IsEnabled=\"{x:Bind Disable.IsChecked.Value.Equals(x:False), Mode=OneWay}\" />",
          "        <CheckBox x:Name=\"Mirror\" Content=\"Mirror\" IsChecked=\"{x:Bind Disable.IsChecked.Value, Mode=OneWay}\" />",
          "    </StackPanel>",
          "</Page>"
        ]
      }
    },
    {
      "id": "setup-page-code",
      "title": "Its code-behind",
      "file": "OptionsPage.xaml.cs",
      "edit": {
        "op": "create-file",
        "text": [
          "using Microsoft.UI.Xaml.Controls;",
          "",
          "namespace TodoBench;",
          "",
          "public sealed partial class OptionsPage : Page",
          "{",
          "    public OptionsPage()",
          "    {",
          "        InitializeComponent();",
          "    }",
          "}"
        ]
      }
    }
  ],
  "dimensions": [],
  "variants": [
    {
      "id": "default",
      "primary": true,
      "summary": "default",
      "choices": {}
    }
  ],
  "segments": [
    {
      "kind": "common",
      "phase": "shell",
      "title": "shell",
      "actions": [
        {
          "id": "s01-window-markup",
          "title": "A window whose constructor takes an argument reloads its markup, keeping the menu items startup code added",
          "file": "MainWindow.xaml",
          "edit": {
            "op": "replace",
            "find": [
              "Text=\"shell v1\""
            ],
            "text": [
              "Text=\"shell v2\""
            ]
          },
          "checkpoint": {
            "id": "c-s01-window-markup",
            "kind": "live",
            "uiChecks": [
              {
                "target": "Label",
                "assert": "text-equals",
                "value": "shell v2"
              },
              {
                "target": "NavHome",
                "assert": "exists"
              },
              {
                "target": "NavBeta",
                "assert": "exists"
              },
              {
                "target": "NavBeta1",
                "assert": "invoke"
              },
              {
                "target": "Selected",
                "assert": "text-equals",
                "value": "Beta 1"
              },
              {
                "target": "NavGamma1",
                "assert": "invoke"
              },
              {
                "target": "Selected",
                "assert": "text-equals",
                "value": "Gamma 1"
              }
            ]
          },
          "expect": {
            "outcome": "applied"
          }
        },
        {
          "id": "s02-app-resources",
          "title": "An App.xaml resource added: the shell keeps its menu items",
          "file": "App.xaml",
          "edit": {
            "op": "replace",
            "find": [
              "        <ResourceDictionary>",
              "            <ResourceDictionary.MergedDictionaries>"
            ],
            "text": [
              "        <ResourceDictionary>",
              "            <x:String x:Key=\"Greeting\">hello</x:String>",
              "            <ResourceDictionary.MergedDictionaries>"
            ]
          },
          "checkpoint": {
            "id": "c-s02-app-resources",
            "kind": "live",
            "uiChecks": [
              {
                "target": "Label",
                "assert": "text-equals",
                "value": "shell v2"
              },
              {
                "target": "NavHome",
                "assert": "exists"
              },
              {
                "target": "NavBeta",
                "assert": "exists"
              }
            ]
          },
          "expect": {
            "outcome": "applied"
          }
        },
        {
          "id": "s03-page-markup",
          "title": "After a page reload, x:Bind through IsChecked.Value still follows the CheckBox",
          "file": "OptionsPage.xaml",
          "edit": {
            "op": "replace",
            "find": [
              "Text=\"options v1\""
            ],
            "text": [
              "Text=\"options v2\""
            ]
          },
          "checkpoint": {
            "id": "c-s03-page-markup",
            "kind": "live",
            "uiChecks": [
              {
                "target": "Heading",
                "assert": "text-equals",
                "value": "options v2"
              },
              {
                "target": "Target",
                "assert": "enabled-equals",
                "value": "True"
              },
              {
                "target": "Disable",
                "assert": "toggle-on"
              },
              {
                "target": "Target",
                "assert": "enabled-equals",
                "value": "False"
              },
              {
                "target": "Mirror",
                "assert": "toggle-state-equals",
                "value": "On"
              }
            ]
          },
          "expect": {
            "outcome": "applied"
          }
        },
        {
          "id": "s04-window-constructor",
          "title": "Changing a constructor that takes arguments says it takes effect at restart",
          "file": "MainWindow.xaml.cs",
          "edit": {
            "op": "replace",
            "find": [
              "Title = $\"TodoBench ({argument})\";"
            ],
            "text": [
              "Title = $\"TodoBench [{argument}]\";"
            ]
          },
          "expect": {
            "outcome": "applied",
            "detail": "note: MainWindow's constructor takes arguments, so a reload only loads its markup again"
          }
        },
        {
          "id": "s05-split-resources",
          "title": "Resources split around another element: the error names App.xaml and the line, as the compiler does",
          "file": "App.xaml",
          "edit": {
            "op": "replace",
            "find": [
              "            </ResourceDictionary.MergedDictionaries>"
            ],
            "text": [
              "            </ResourceDictionary.MergedDictionaries>",
              "            <x:String x:Key=\"Farewell\">bye</x:String>"
            ]
          },
          "expect": {
            "outcome": "error",
            "detail": "App\\.xaml\\(13,\\d+\\): This dictionary's resources are split by another element"
          }
        },
        {
          "id": "s06-split-resources-fixed",
          "title": "Moving it next to the other resource fixes it",
          "file": "App.xaml",
          "edit": {
            "op": "replace",
            "find": [
              "            </ResourceDictionary.MergedDictionaries>",
              "            <x:String x:Key=\"Farewell\">bye</x:String>"
            ],
            "text": [
              "            </ResourceDictionary.MergedDictionaries>"
            ]
          },
          "checkpoint": {
            "id": "c-s06-split-resources-fixed",
            "kind": "live",
            "uiChecks": [
              {
                "target": "NavHome",
                "assert": "exists"
              },
              {
                "target": "NavBeta",
                "assert": "exists"
              },
              {
                "target": "NavBeta1",
                "assert": "invoke"
              },
              {
                "target": "Selected",
                "assert": "text-equals",
                "value": "Beta 1"
              },
              {
                "target": "NavGamma1",
                "assert": "invoke"
              },
              {
                "target": "Selected",
                "assert": "text-equals",
                "value": "Gamma 1"
              }
            ]
          },
          "expect": {
            "outcome": "applied"
          }
        },
        {
          "id": "s07-static-data",
          "title": "A class with static data",
          "file": "Catalog.cs",
          "edit": {
            "op": "create-file",
            "text": [
              "namespace TodoBench;",
              "",
              "public static class Catalog",
              "{",
              "    public static readonly string[] Names = [\"one\"];",
              "}"
            ]
          },
          "expect": {
            "outcome": "applied"
          }
        },
        {
          "id": "s08-static-data-changed",
          "title": "Changing static data that was already initialized says it takes effect at restart",
          "file": "Catalog.cs",
          "edit": {
            "op": "replace",
            "find": [
              "[\"one\"]"
            ],
            "text": [
              "[\"one\", \"two\"]"
            ]
          },
          "expect": {
            "outcome": "applied",
            "detail": "note: Catalog\\.Names is set once, when the app starts"
          }
        }
      ]
    }
  ]
}
